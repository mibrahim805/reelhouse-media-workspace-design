{
  "name": "reelhouse-android",
  "version": "0.1.3",
  "description": "Native Reelhouse client for Android",
  "private": true,
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "build:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "build:release": "npm run sync && cd android && ./gradlew assembleRelease"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "typescript": "5.9.3"
  }
}
